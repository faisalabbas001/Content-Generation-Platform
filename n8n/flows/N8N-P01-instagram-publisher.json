    {
      "parameters": {
        "jsCode": "const post    = $('Supabase: Fetch Post').first().json;\nconst channel = $input.first().json;\nconst input   = $('Validate Input').first().json;\n\n// Guard: Postiz channel must be connected\nif (!channel || !channel.postiz_channel_id) {\n  throw new Error(\n    'POSTIZ_NOT_CONNECTED: No Postiz channel ID for brand ' + input.brand_id +\n    '. Visit /{slug}/settings to connect Instagram via Postiz.'\n  );\n}\n\n// Guard: image must exist\nif (!post.storage_url) {\n  throw new Error('NO_IMAGE: calendar_posts row has no storage_url.');\n}\n\n// Guard: posting_time must be a valid future datetime\nconst postingTime = new Date(post.posting_time);\nif (isNaN(postingTime.getTime())) {\n  throw new Error('INVALID_POSTING_TIME: ' + post.posting_time);\n}\nif (postingTime <= new Date()) {\n  throw new Error(\n    'POSTING_TIME_PAST: ' + post.posting_time +\n    ' is in the past. Mark post as manual_required instead.'\n  );\n}\n\n// Build caption: Arabic text + hashtags separated by a blank line\nconst hashtagStr = Array.isArray(post.hashtags)\n  ? post.hashtags.join(' ')\n  : (post.hashtags || '');\nconst caption = [post.caption_ar, hashtagStr].filter(Boolean).join('\\n\\n');\n\n// Extract storage path for Supabase signed URL.\n// URL format: https://<project>.supabase.co/storage/v1/object/public/post-images/<path>\nconst storagePath = post.storage_url.match(/\\/post-images\\/(.+)/)?.[1];\nif (!storagePath) {\n  throw new Error('INVALID_STORAGE_URL: cannot extract path from: ' + post.storage_url);\n}\n\nreturn {\n  post_id:           input.post_id,\n  brand_id:          input.brand_id,\n  postiz_channel_id: channel.postiz_channel_id,\n  caption,\n  posting_time_iso:  postingTime.toISOString(),\n  storage_path:      decodeURIComponent(storagePath),\n};"
      },
      "id": "node-5-validate-prepare",
      "name": "Code: Validate & Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/storage/v1/object/sign/post-images/{{ $json.storage_path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"expiresIn\": 3600 }"
      },
      "id": "node-6-signed-url",
      "name": "HTTP: Get Signed URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        300
