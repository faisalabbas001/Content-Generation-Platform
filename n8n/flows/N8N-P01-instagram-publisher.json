    {
      "parameters": {
        "jsCode": "const upload = $input.first().json;            // Postiz /upload response: {id, path, ...}\nconst prev   = $('Code: Validate & Prepare').first().json;\n\nif (!upload || !upload.id || !upload.path) {\n  throw new Error('POSTIZ_UPLOAD_FAILED: ' + JSON.stringify(upload));\n}\n\n// Shape validated against the live Postiz public API (2026-06):\n//   - media must be uploaded to Postiz first (POST /upload) and referenced\n//     via posts[0].value[0].image as [{id, path}] — raw URLs are rejected\n//   - top-level `tags` is required (array)\n//   - posts[0].settings.post_type is required: 'post' | 'story'\nconst postizPayload = {\n  type:      'schedule',\n  date:      prev.posting_time_iso,\n  shortLink: false,\n  tags:      [],\n  posts: [{\n    integration: { id: prev.postiz_channel_id },\n    value: [{ content: prev.caption, image: [{ id: upload.id, path: upload.path }] }],\n    settings: { post_type: 'post' },\n  }],\n};\n\nreturn {\n  ...prev,\n  postiz_media:   { id: upload.id, path: upload.path },\n  postiz_payload: postizPayload,\n};\n"
      },
      "id": "node-7-build-payload",
      "name": "Code: Build Postiz Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.postiz.com/public/v1/posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $vars.POSTIZ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.postiz_payload }}"
      },
      "id": "node-8-postiz-post",
      "name": "HTTP: Create Postiz Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1640,
        300
