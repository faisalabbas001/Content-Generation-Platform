    {
      "parameters": {
        "jsCode": "// Build HMAC-signed S03 alert — fires on any unhandled P01 error.\nconst crypto = require('crypto');\nconst SECRET = 'c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887';\nconst e = $json;\n\nlet brand_id = null;\ntry { brand_id = $('Validate Input').first().json.brand_id ?? null; } catch (_) {}\n\nconst makeUUID = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n});\n\nconst body = JSON.stringify({\n  anomaly_id:   makeUUID(),\n  anomaly_type: 'publishing_failed',\n  severity:     'error',\n  source_flow:  'N8N-P01',\n  brand_id,\n  message:      e.execution?.error?.message || 'P01 Instagram publisher flow failed',\n  details: {\n    failed_node:  e.execution?.lastNodeExecuted ?? null,\n    error_name:   e.execution?.error?.name      ?? null,\n    execution_id: e.execution?.id               ?? null,\n  },\n  timestamp: new Date().toISOString(),\n});\n\nconst sig = crypto.createHmac('sha256', SECRET).update(body).digest('hex');\nreturn {\n  _body: body,\n  _headers: {\n    'content-type':     'application/json',\n    'x-n8n-signature':  sig,\n    'x-n8n-request-id': `${$execution.id}-err-p01`,\n    'x-n8n-timestamp':  new Date().toISOString(),\n  },\n};"
      },
      "id": "p01-err-build-alert",
      "name": "Build S03 alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        700
      ]
    },
    {
      "parameters": {
        "method": "POST",
