    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body || $input.first().json;\n\nif (!payload.post_id || !payload.brand_id) {\n  throw new Error('post_id and brand_id are required');\n}\n\nreturn {\n  post_id:     payload.post_id.trim(),\n  brand_id:    payload.brand_id.trim(),\n  slug:        payload.slug || null,\n  flow_id:     'N8N-P01',\n  received_at: new Date().toISOString()\n};"
      },
      "id": "node-2-validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
