    },
    {
      "parameters": {
        "operation": "getAll",
        "table": "channel_profiles",
        "filters": {
          "conditions": [
            {
              "field": "brand_id",
              "operator": "eq",
              "value": "={{ $('Supabase: Fetch Post').item.json.brand_id }}"
            },
            {
              "field": "channel",
              "operator": "eq",
