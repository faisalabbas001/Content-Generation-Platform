            }
          ]
        },
        "options": {
          "limit": 1
        }
      },
      "id": "node-4-fetch-channel",
      "name": "Supabase: Fetch Channel",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        840,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "1",
          "name": "Supabase Service Role"
        }
      },
      "onError": "continueErrorOutput"
