    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst prev     = $('Code: Build Postiz Payload').first().json;\n\nconsole.log('[P01] Postiz response:', JSON.stringify(response));\n\n// Live API returns an ARRAY: [{ postId, integration }]. Older builds returned\n// an object with `id` — accept both.\nconst first = Array.isArray(response) ? response[0] : response;\nconst postizPostId = first && (first.postId || first.id);\nif (!postizPostId) {\n  throw new Error(\n    'POSTIZ_POST_FAILED: no post id returned. Response: ' + JSON.stringify(response)\n  );\n}\n\nreturn {\n  post_id:        prev.post_id,\n  brand_id:       prev.brand_id,\n  postiz_post_id: String(postizPostId),\n};\n"
      },
