    {
      "parameters": {
        "jsCode": "const error        = $input.first().json.error || $input.first().json;\nconst errorMessage = typeof error === 'string' ? error : (error.message || JSON.stringify(error));\n\nlet post_id  = null;\nlet brand_id = null;\ntry {\n  post_id  = $('Validate Input').first().json.post_id;\n  brand_id = $('Validate Input').first().json.brand_id;\n} catch (_) {}\n\nconsole.error('[P01] Error — post_id=' + post_id + ':', errorMessage);\n\n// POSTING_TIME_PAST means the content is ready but automation missed the window.\n// Flag for manual publishing rather than marking as a failure.\nconst isManualRequired = errorMessage.startsWith('POSTING_TIME_PAST');\n\nreturn {\n  post_id,\n  brand_id,\n  publish_status: isManualRequired ? 'manual_required' : 'failed',\n  error_message:  errorMessage,\n};"
      },
