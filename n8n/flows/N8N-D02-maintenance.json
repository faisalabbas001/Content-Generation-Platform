        "jsCode": "// Build the maintenance report. Explicitly reference upstream nodes by name\n// because the previous node (Archive Stale Copilot Threads) returns an empty\n// body (Prefer: return=minimal), so $json cannot carry the drain result.\nconst drain = $('POST · /api/memory/process').first().json?.result || {};\nconst cfg = $('Build maintenance config').first().json;\nconst inserted = $('Sign · memory drain').first().json.inserted_count ?? 0;\nconst staleSelected = $('Supabase · SELECT stale evidence_bundles').all().length;\nconst duration_ms = cfg.started_at ? Date.now() - cfg.started_at : 0;\n\nreturn [{ json: {\n  flow_id: 'N8N-D02',\n  batch_id: cfg.batch_id,\n  bundles_evaluated: staleSelected,\n  nominations_enqueued: inserted,\n  drained_total: drain.total ?? 0,\n  drained_written: drain.written ?? 0,\n  drained_rejected: drain.rejected ?? 0,\n  copilot_threads_archived: true,\n  generated_at: cfg.generated_at,\n  duration_ms,\n}}];"
