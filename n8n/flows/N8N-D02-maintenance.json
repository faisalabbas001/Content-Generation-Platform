    {
      "parameters": {
        "jsCode": "// ── Build all confidence_upgrade nominations in ONE pass ──\n//\n// Grace period: brands with an approved post in the last 30 days are skipped.\n// Their evidence_bundles are still stale but the brand is actively managed —\n// downgrading them now would create false urgency in the next COO run.\n//\n// Per Hard Rule #2: we never UPDATE evidence_bundles directly. We enqueue\n// confidence_upgrade nominations and let the Memory Controller validate +\n// apply them. The downgrade rule (mirrors field_confidence_type enum):\n//   - age > 365d      → deprecated (any value)\n//   - inferred_high   → inferred_medium\n//   - inferred_medium → inferred_low\n//   - inferred_low    → inferred_low (sticks — no nomination emitted)\n//   - all others (explicitly_confirmed, rejected, deprecated) → unchanged\n\nconst bundles = $('Supabase · SELECT stale evidence_bundles').all().map(it => it.json);\n\n// Active brands = those with an approved post in the last 30 days.\n// Supabase node emits one n8n item per row.\nconst activeBrandIds = new Set(\n  $input.all().map(it => it.json?.brand_id).filter(Boolean)\n);\n\nconst now = Date.now();\n\nconst nominations = bundles\n  .filter(b => !activeBrandIds.has(b.brand_id))\n  .map(b => {\n    const lastEval = new Date(b.last_evaluated).getTime();\n    const ageDays = Math.floor((now - lastEval) / 86400000);\n    const cur = b.field_confidence;\n    let next;\n    if (ageDays > 365) next = 'deprecated';\n    else if (cur === 'inferred_high') next = 'inferred_medium';\n    else if (cur === 'inferred_medium') next = 'inferred_low';\n    else if (cur === 'inferred_low') next = 'inferred_low';\n    else next = cur; // explicitly_confirmed / rejected / deprecated → leave alone\n    return { brand_id: b.brand_id, ageDays, cur, next, field_name: b.field_name };\n  })\n  // Drop no-op rows so we don't churn the queue with rows that wouldn't change anything.\n  .filter(r => r.next !== r.cur);\n\nconst bundleCount = bundles.length;\nconst candidateCount = nominations.length;\n\n// Emit one item per nomination. Downstream Supabase node will batch-insert.\nreturn nominations.map(r => ({ json: {\n  brand_id: r.brand_id,\n  nomination_type: 'confidence_upgrade',\n  nomination_data: {\n    field_name: r.field_name,\n    new_state: r.next,\n    evidence_source_ids: [],\n    reasoning: 'D02 maintenance age decay: ' + r.ageDays + 'd since last evaluation',\n    previous_confidence: r.cur,\n  },\n  nominated_by: 'D02_maintenance',\n  _candidate_count: candidateCount,\n  _bundle_count: bundleCount,\n}}));"
      },
      "id": "d02-build-nominations",
      "name": "Build all nominations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ]
    },
