      "id": "d02-fetch-active-brands",
      "name": "Fetch active brand IDs (grace period)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        800,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "openclaw_supabase",
          "name": "OGz Studios Supabase"
