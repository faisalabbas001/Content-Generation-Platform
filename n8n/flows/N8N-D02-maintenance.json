      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst SECRET = 'c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887';\nconst e = $json;\n\nconst makeUUID = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n});\n\nconst body = JSON.stringify({\n  anomaly_id:   makeUUID(),\n  anomaly_type: 'flow_failure',\n  severity:     'critical',\n  source_flow:  'N8N-D02',\n  brand_id:     null,\n  message:      e.execution?.error?.message || 'D02 maintenance flow failed',\n  details: {\n    failed_node:  e.execution?.lastNodeExecuted ?? null,\n    error_name:   e.execution?.error?.name      ?? null,\n    execution_id: e.execution?.id               ?? null,\n  },\n  timestamp: new Date().toISOString(),\n});\n\nconst sig = crypto.createHmac('sha256', SECRET).update(body).digest('hex');\nreturn {\n  anomaly_type: 'flow_failure',\n  severity:     'critical',\n  flow_id:      'N8N-D02',\n  brand_id:     null,\n  message:      e.execution?.error?.message || 'D02 maintenance flow failed',\n  details: {\n    failed_node:  e.execution?.lastNodeExecuted ?? null,\n    error_name:   e.execution?.error?.name      ?? null,\n  },\n  timestamp: new Date().toISOString(),\n  _body: body,\n  _headers: {\n    'content-type':     'application/json',\n    'x-n8n-signature':  sig,\n    'x-n8n-request-id': `${$execution.id}-err-d02`,\n    'x-n8n-timestamp':  new Date().toISOString(),\n  },\n};"
      },
