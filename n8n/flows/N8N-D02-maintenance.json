      "parameters": {
        "jsCode": "// Collapse the Supabase INSERT's per-row outputs into ONE item, then sign\n// /api/memory/process. Returning a single-item array forces every downstream\n// node to fire exactly once (instead of once per inserted nomination).\nconst crypto = require('crypto');\nconst body = JSON.stringify({ flow_id: 'N8N-D02', batch_size: 500 });\nconst ts = new Date().toISOString();\nconst reqId = crypto.randomUUID();\nconst sig = crypto.createHmac('sha256', 'c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887').update(body).digest('hex');\n\n// Carry the count of inserted rows for the audit/report.\nconst inserted = $input.all().length;\n\nreturn [{ json: {\n  _drain_body: body,\n  _drain_headers: {\n    'content-type': 'application/json',\n    'x-n8n-signature': sig,\n    'x-n8n-request-id': reqId,\n    'x-n8n-timestamp': ts,\n  },\n  inserted_count: inserted,\n}}];"
      },
