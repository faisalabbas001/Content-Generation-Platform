    {
      "parameters": {
        "jsCode": "// Read-only context used by every downstream node.\nconst now = new Date();\nreturn { json: {\n  flow_id: 'N8N-D02',\n  batch_id: `maintenance-${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`,\n  generated_at: now.toISOString(),\n  started_at: Date.now(),\n  stale_threshold_days: 90,\n  deprecated_threshold_days: 365,\n}};"
      },
      "id": "d02-config",
      "name": "Build maintenance config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "evidence_bundles",
        "filters": {
          "conditions": [
            {
              "keyName": "last_evaluated",
              "condition": "lt",
              "keyValue": "={{ new Date(Date.now() - $json.stale_threshold_days*24*60*60*1000).toISOString() }}"
            }
          ]
        },
        "returnAll": true,
        "options": {}
