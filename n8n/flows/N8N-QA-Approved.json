    {
      "id": "qa-approved-verify",
      "name": "Verify HMAC + parse body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = process.env.N8N_WEBHOOK_SECRET;\nconst body   = $input.first().json.body ?? $input.first().json;\nconst sig    = $input.first().headers?.['x-n8n-signature'] ?? '';\nif (secret) {\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(JSON.stringify(body)).digest('hex');\n  if (sig !== expected) throw new Error('HMAC mismatch — rejected');\n}\nconst brand_id   = body.brand_id;\nconst queue_id   = body.queue_id;\nconst request_id = body.request_id;\n// decision: the web app sends 'rejected' when an admin rejects a QA item and\n// 'approved' (or omits it) when approving. Only the approve path may generate.\nconst decision   = (body.decision ?? 'approved').toString().toLowerCase();\nif (!brand_id || !queue_id) throw new Error('Missing brand_id or queue_id');\nreturn [{ json: { brand_id, queue_id, request_id: request_id ?? null, decision } }];"
      }
    },
    {
      "id": "qa-branch-decision",
      "name": "Branch: rejected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-rejected",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "rejected",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
