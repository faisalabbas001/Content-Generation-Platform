      "id": "qa-approved-webhook",
      "name": "Webhook POST /webhook/openclaw-qa-approved",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "openclaw-qa-approved",
