    {
      "id": "qa-prepare-v01",
      "name": "Prepare V01 inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const prep     = $('Prepare calendar_posts insert').first().json;\nconst inserted = $('Supabase: insert calendar_posts').first().json;\nconst post_id  = inserted.post_id;\nif (!post_id) throw new Error('calendar_posts insert returned no post_id');\n\nreturn [{ json: {\n  brand_id:          prep.__brand_id,\n  post_id:           post_id,\n  prompt_en:         prep.__prompt_en,\n  brand_name_ar:     prep.__brand_name_ar,\n  headline_ar:       prep.__caption_ar,\n  dialect:           prep.__dialect,\n  channel:           prep.__platform,\n  objective:         prep.__objective,\n  confidence_flag:   prep.__confidence_flag,\n  primary_color_hex: prep.__primary_color,\n  month:             prep.__month,\n  reference_image_url: null,\n  revision_count:    0,\n  chain_id:          null,\n  // carry-through for later updates\n  __queue_id:        prep.__queue_id,\n  __request_id:      prep.__request_id,\n  __post_id:         post_id,\n} }];"
