    {
      "id": "qa-prepare-calendar",
      "name": "Prepare calendar_posts insert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const verify   = $('Verify HMAC + parse body').first().json;\nconst queueRow = $('Supabase: fetch qa_review_queue row').first().json;\nconst reqRow   = $('Supabase: fetch on_demand_requests row').first().json;\nconst brand    = $('Supabase: fetch brand_profiles').first().json;\n\n// brand_id: prefer brand fetch (most authoritative) then webhook\nconst brand_id = brand.brand_id ?? verify.brand_id;\n\n// Normalise arabic_dialect to V01 enum values.\n// DB column is arabic_dialect (not dialect).\nconst DIALECT_NORM = {\n  'msa': 'MSA_accessible', 'msa_accessible': 'MSA_accessible',\n  'msa_formal': 'MSA_formal', 'gulf': 'Gulf', 'najdi': 'Najdi',\n  'hejazi': 'Hejazi', 'mixed': 'Mixed',\n  'MSA_accessible': 'MSA_accessible', 'MSA_formal': 'MSA_formal',\n  'Gulf': 'Gulf', 'Najdi': 'Najdi', 'Hejazi': 'Hejazi', 'Mixed': 'Mixed',\n};\nconst rawDialect = brand.arabic_dialect ?? brand.dialect ?? 'MSA_accessible';\nconst dialect = DIALECT_NORM[rawDialect] ?? DIALECT_NORM[rawDialect.toLowerCase().replace(/[\\s-]/g,'_')] ?? 'MSA_accessible';\n\n// caption_ar: for CEO/CCO holds the caption was already generated by DeepSeek\n// and stored in qa_review_queue.caption_ar. For dialect holds it fires before\n// generation so caption_ar is null — fall back to the brief's hero_concept so\n// the Sharp overlay always has SOME Arabic-translatable text.\n// (V01's overlay.ts skips silently if headline_ar has no Arabic chars.)\nconst caption_ar = queueRow.caption_ar || null;\n\n// month for V01 storage key: prefer posting_time from on_demand_requests\nconst postingTime = reqRow.posting_time || new Date().toISOString();\nconst month = postingTime.slice(0, 7);\n\nreturn [{ json: {\n  brand_id:           brand_id,\n  caption_ar:         caption_ar ?? '',\n  confidence_score:   queueRow.cco_score  ?? 85,\n  watermark:          false,\n  status:             'draft',\n  on_demand_request_id: verify.request_id,\n  // V01 inputs passed through\n  __brand_id:         brand_id,\n  __queue_id:         verify.queue_id,\n  __request_id:       verify.request_id,\n  __caption_ar:       caption_ar ?? '',\n  __cco_score:        queueRow.cco_score  ?? 85,\n  __prompt_en:        reqRow.style_descriptor ?? reqRow.hero_concept ?? 'product lifestyle photography, clean background',\n  __objective:        reqRow.objective  ?? 'awareness',\n  __platform:         reqRow.platform   ?? 'Instagram',\n  __brand_name_ar:    brand.brand_name_ar ?? '',\n  __dialect:          dialect,\n  __primary_color:    brand.primary_color_hex ?? '',\n  __confidence_flag:  'clean',\n  __month:            month,\n} }];"
      }
    },
