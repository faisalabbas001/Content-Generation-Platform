    {
      "parameters": {
        "jsCode": "// Build Email Payload — reads Prepare Brand Data + Merge Posts Data1 directly.\n// Runs when Loop Each Post1 finishes all iterations (output[1] = \"done\" port).\nconst brandData = $('Prepare Brand Data').first().json || {};\n\n// Collect post stats directly from Merge Posts Data1 (always available at this point)\nlet allPosts = [], visualPosts = [];\ntry { allPosts  = $('Merge Posts Data1').all().map(i => i.json || {}); } catch(_) {}\ntry { visualPosts = $('Merge Visual Results1').all().map(i => i.json || {}); } catch(_) {}\n\nconst postsGenerated  = allPosts.length;\nconst postsClean      = allPosts.filter(p => p.route === 'CLEAN').length;\nconst postsWatermarked= allPosts.filter(p => p.route === 'WATERMARK').length;\nconst postsHeld       = allPosts.filter(p => p.route === 'HOLD').length;\nconst visualFails     = visualPosts.filter(p => p.visual_failed).length;\nconst watermarkCount  = postsWatermarked;\nconst holdCount       = postsHeld;\nconst isFirst         = brandData.is_first_calendar === true;\nconst isPartial       = brandData.is_partial === true;\n\n// Rule 1: no posts → failure email\n// Rule 4: HOLDs → warning line\n// Rule 5: visual fails → warning\n// Rule 6: watermarks → review note\n// Rule 7: first calendar → welcome\n// Rule 8: video failures\nlet videoFailedIds = [];\ntry { videoFailedIds = allPosts.filter(p => p.format_tier === 'video' && p.visual_failed).map(p => p.post_id); } catch(_) {}\n// Rule 9: partial month\n// Rule 10: brave_route posts\nlet braveCount = 0;\ntry { braveCount = allPosts.filter(p => p.brave_route_flag === true).length; } catch(_) {}\n// Rule 11: hard blocks\nlet hardBlockCount = 0;\ntry { hardBlockCount = allPosts.filter(p => (p.negpat_flag||'') === 'HARD_BLOCK').length; } catch(_) {}\n\nconst brand_name  = brandData.brand_name_ar || '';\nconst month       = brandData.month || '';\nconst batch_id    = brandData.batch_id || '';\nconst client_email= brandData.client_email || '';\nconst client_slug = brandData.client_slug || '';\n\n// Skip email if no recipient\nif (!client_email) return [];\n\nlet subject, bodyLines = [];\n\nif (postsGenerated === 0) {\n  subject = `[خطأ] فشل إنشاء التقويم – ${brand_name} – ${month}`;\n  bodyLines.push(`<p>لم يتم إنشاء أي منشور. يرجى مراجعة سجلات النظام.</p>`);\n} else {\n  subject = `تقويم ${month} جاهز! | ${brand_name}`;\n  bodyLines.push(`<p>تم إنشاء تقويم <strong>${month}</strong> بنجاح وهو جاهز للمراجعة والنشر.</p>`);\n  bodyLines.push(`<ul>`);\n  bodyLines.push(`<li>عدد المنشورات: <strong>${postsGenerated}</strong></li>`);\n  bodyLines.push(`<li>المنشورات النظيفة: <strong>${postsClean}</strong></li>`);\n  if (watermarkCount > 0) bodyLines.push(`<li>⚠️ منشورات بعلامة مائية: <strong>${watermarkCount}</strong></li>`);\n  if (holdCount > 0)      bodyLines.push(`<li>⚠️ منشورات موقوفة (HOLD): <strong>${holdCount}</strong></li>`);\n  if (visualFails > 0)    bodyLines.push(`<li>⚠️ فشل إنشاء الصور: <strong>${visualFails}</strong></li>`);\n  if (videoFailedIds.length > 0) bodyLines.push(`<li>⚠️ فشل الفيديو: ${videoFailedIds.slice(0,5).join(', ')}</li>`);\n  if (isPartial)          bodyLines.push(`<li>ℹ️ تقويم جزئي (منتصف الشهر)</li>`);\n  if (braveCount > 0)     bodyLines.push(`<li>⚠️ تحذير امتثال: ${braveCount} منشور brave_route</li>`);\n  if (hardBlockCount > 0) bodyLines.push(`<li>🚨 مراجعة فورية: ${hardBlockCount} منشور HARD_BLOCK</li>`);\n  bodyLines.push(`</ul>`);\n  if (isFirst) bodyLines.push(`<p style='color:#0e7490;'><strong>🎉 مرحباً! هذا أول تقويم لعلامتكم مع OpenClaw.</strong></p>`);\n  bodyLines.push(`<p><a href='https://app.openclaw.com/${client_slug}/calendar' style='background:#0e7490;color:#fff;padding:12px 28px;border-radius:6px;text-decoration:none;display:inline-block;'>عرض التقويم</a></p>`);\n}\n\nbodyLines.push(`<p style='color:#64748b;font-size:13px;'>المرجع: ${batch_id}</p>`);\nconst html = `<html dir='rtl' lang='ar'><body style='font-family:Noto Kufi Arabic,sans-serif;line-height:1.8;padding:24px;color:#0f172a;'><h1 style='color:#0e7490;'>${brand_name}</h1>${bodyLines.join('')}</body></html>`;\n\nreturn [{ json: { to: client_email, subject, html } }];"
      },
