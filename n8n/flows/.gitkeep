    {
      "parameters": {
        "jsCode": "const post=$json;\nconst RELIGIOUS_PATTERNS=[/قرآن|القرآن|آية|حديث|النبي|الصلاة|الزكاة|الحج|الصوم|رمضان.*ديني|سورة|دعاء/u,/\\b(quran|hadith|prophet\\s+muhammad|pbuh|sallallahu|salah|zakat|islamic\\s+prayer|dua\\b|surah)\\b/i];\nconst GESTURE_HARD_BLOCKS=['left hand serv','left hand exchang','left hand offer','sole point','sole of foot','beckoning palm','palm.up beckon','cross.gender contact','cross gender contact','food consumption ramadan','eating.*ramadan.*daylight','daytime.*ramadan.*eat','quran.*mishandl','mishandl.*quran','index finger point','pointing.*index finger','western head shake','head.shake.*no','counting.*index finger','counting.*wrong'];\nconst captionText=(post.caption_ar||'');\nconst briefText=(post.visual_brief_en||post.prompt_en||'').toLowerCase();\nconst combined=captionText+' '+briefText;\nlet compliance_block=false,compliance_reason=null;\nif(post.religious_sensitivity==='High'){for(const p of RELIGIOUS_PATTERNS){if(p.test(combined)){compliance_block=true;compliance_reason='religious_content';break;}}}\nif(!compliance_block){for(const kw of GESTURE_HARD_BLOCKS){const re=new RegExp(kw,'i');if(re.test(briefText)){compliance_block=true;compliance_reason='gesture_hard_block:'+kw.replace(/\\\\./, '');break;}}}\nif(!compliance_block&&post.brave_route_flag===true){compliance_block=true;compliance_reason='brave_route_override';}\nif(!compliance_block&&post.sector==='Healthcare'){if(['educational','testimonial'].includes(post.content_type)){compliance_block=true;compliance_reason='healthcare_content_type';}}\nif(!compliance_block&&post.sector==='Finance'&&post.brave_route_flag===true){compliance_block=true;compliance_reason='finance_brave_route';}\nif(!compliance_block&&(post.sector||'').toLowerCase()==='government'){compliance_block=true;compliance_reason='government_sector';}\nif(compliance_block){\n  return [{ json:{...post,compliance_block:true,compliance_reason,\n    flags:{...(post.flags||{}),route:'HOLD',negpat_flag:compliance_reason==='brave_route_override'?'STRONG_WARN':'HARD_BLOCK',compliance_block:true,compliance_reason},\n    trigger_reason:compliance_reason==='religious_content'?'compliance_religious_content':compliance_reason==='brave_route_override'?'brave_route_flag':compliance_reason==='healthcare_content_type'?'healthcare_sector_hold':compliance_reason==='finance_brave_route'?'finance_sector_hold':compliance_reason==='government_sector'?'government_sector_hold':'compliance_visual_block',\n    route:'HOLD'\n  }}];\n}\nreturn [{ json:{...post,compliance_block:false} }];"
      },
