      "parameters": {
        "jsCode": "// Fallback to {result:{slots:[]}} when response lacks result.slots (matches original safe default).\nconst item = $input.first().json || {};\nlet resp = item;\nif (!item || typeof item !== 'object' || !item.result || !Array.isArray(item.result.slots)) {\n  resp = { result: { slots: [] } };\n}\nreturn [{ json: resp }];"
