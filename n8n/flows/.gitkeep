    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst input = $input.all()[0].json;\n\nif (!input.brand_id) {\n  console.warn('[V01] WARNING: brand_id is missing from input:', JSON.stringify(Object.keys(input)));\n}\n\nconst promptEn = (input.prompt_en || '').trim() || 'product lifestyle photography, clean background, natural lighting';\n\n// Map DeepSeek sharp_text_gravity → OverlayLayout.\nconst GRAVITY_TO_LAYOUT = { south: 'bottom-right', north: 'top-right', center: 'center-right' };\nconst layout = GRAVITY_TO_LAYOUT[input.sharp_text_gravity];\n\n// SMART MONTH CONVERSION - handles both \"June\" and \"2026-06\" formats\nfunction formatMonth(monthInput, yearInput) {\n  if (!monthInput) {\n    return new Date().toISOString().slice(0, 7);\n  }\n  \n  // Check if it's already in YYYY-MM format\n  if (/^\\d{4}-\\d{2}$/.test(monthInput)) {\n    return monthInput;\n  }\n  \n  // Check if it's a month name like \"June\"\n  const monthNames = {\n    'January': '01', 'February': '02', 'March': '03', 'April': '04',\n    'May': '05', 'June': '06', 'July': '07', 'August': '08',\n    'September': '09', 'October': '10', 'November': '11', 'December': '12'\n  };\n  \n  // Try to match the month name (case insensitive)\n  const monthName = Object.keys(monthNames).find(\n    name => name.toLowerCase() === monthInput.toLowerCase()\n  );\n  \n  if (monthName) {\n    // Use the provided year, or current year if not available\n    const year = yearInput || new Date().getFullYear();\n    return `${year}-${monthNames[monthName]}`;\n  }\n  \n  // If it's a number (1-12), format it\n  if (/^\\d{1,2}$/.test(monthInput)) {\n    const year = yearInput || new Date().getFullYear();\n    const monthNum = monthInput.padStart(2, '0');\n    return `${year}-${monthNum}`;\n  }\n  \n  // Fallback to current month\n  console.warn(`[V01] Unrecognized month format: ${monthInput}, using current month`);\n  return new Date().toISOString().slice(0, 7);\n}\n\n// Handle palette_hex from various sources\nlet paletteHex = input.palette_hex || [];\nif (input.primary_color_hex && input.primary_color_hex.trim() !== '') {\n  paletteHex = [input.primary_color_hex];\n}\nif (paletteHex.length === 0 && input.brand_color_palette) {\n  paletteHex = input.brand_color_palette;\n}\n\nconst payload = {\n  flow_id:  'N8N-V01',\n  brand_id: input.brand_id  || 'MISSING',\n  post_id:  input.post_id   || crypto.randomUUID(),\n  payload: {\n    prompt_en:           promptEn,\n    brand_name_ar:       input.brand_name_ar   || input.brand_name_en || '',\n    headline_ar:         input.headline_ar     || input.caption_ar || '',\n    dialect:             input.dialect         || 'MSA_formal',\n    channel:             input.channel         || 'Instagram',\n    objective:           input.objective       || 'awareness',\n    first_ever_post:     input.first_ever_post || false,\n    confidence_flag:     input.confidence_flag || 'clean',\n    cost_constraint:     input.cost_constraint || 'standard',\n    palette_hex:         paletteHex,\n    month:               formatMonth(input.month, input.year),\n    score:               input.score || input.confidence_score || 85,\n    expected_media_type: input.expected_media_type || input.media_type || input.format_tier || 'image',\n    reference_image_url: input.reference_image_url || undefined,\n    chain_id:            input.chain_id        || null,\n    chain_context:       input.chain_context   || undefined,\n    layout:              layout,\n  }\n};\n\nconst raw = JSON.stringify(payload);\nconst sig = crypto.createHmac('sha256', 'c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887').update(raw).digest('hex');\n\nreturn [{ json: {\n  url:      'https://unwieldable-mavis-unbacked.ngrok-free.dev/api/image/generate',\n  body:     raw,\n  brand_id: input.brand_id,\n  post_id:  payload.post_id,\n  headers: {\n    'x-n8n-signature':  sig,\n    'x-n8n-request-id': crypto.randomUUID(),\n    'x-n8n-timestamp':  new Date().toISOString(),\n  }\n}}];"
      },
