    {
      "parameters": {
        "jsCode": "const batchCfg = $(\"Prepare Batch Config\").first().json;\nconst targetBrandId = batchCfg.target_brand_id||null;\nconst seen = new Set(); const result = [];\nfor (const item of $input.all()) {\n  const b = item.json;\n  if(!b.brand_id) continue;\n  if(b.tier==='free'&&(b.total_calendars_generated||0)>0) continue;\n  if(targetBrandId&&b.brand_id!==targetBrandId) continue;\n  if(!seen.has(b.brand_id)){seen.add(b.brand_id);result.push({json:b});}\n}\nreturn result;"
      },
