    {
      "parameters": {
        "jsCode": "const crypto    = require('crypto');\nconst brandData  = $('Prepare Brand Data').first().json;\nconst ceoResult  = $('Call: CEO Route & Classify').first().json?.result || {};\nconst secret     = 'c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887';\nconst requestId  = crypto.randomUUID();\nconst timestamp  = new Date().toISOString();\nlet postsGenerated = 0;\ntry { postsGenerated = $('Merge Posts Data1').all().length; } catch(_) {}\nconst body = JSON.stringify({\n  flow_id:'N8N-A01', brand_id:brandData.brand_id,\n  payload:{\n    batch_id:brandData.batch_id, month:brandData.month_key, outcome:'calendar_generated',\n    pipeline:ceoResult.decision?.pipeline||'A', confidence_mode:ceoResult.decision?.confidence_mode||'Standard',\n    agents_dispatched:['CEO','COO','DeepSeek','MatchChain','CCO'], posts_generated:postsGenerated,\n    cost_constraint:ceoResult.decision?.cost_status||'normal',\n    n8n_execution_id:$execution.id,\n    workflow_trigger:$('Prepare Batch Config').first().json.batch_type==='MONTHLY'?'cron_monthly':'cron_weekly'\n  }\n});\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nconst _base = 'https://unwieldable-mavis-unbacked.ngrok-free.dev';\nreturn [{ json: {\n  _url: _base + '/api/agents/ceo/batch-complete',\n  _body: body,\n  _headers: {\n    'content-type':'application/json','x-n8n-signature':signature,\n    'x-n8n-request-id':requestId,'x-n8n-timestamp':timestamp\n  }\n}}];"
