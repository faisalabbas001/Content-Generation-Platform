    {
      "parameters": {
        "jsCode": "const brand = $input.first().json;\nconst batchConfig = $('Prepare Batch Config').first().json;\nconst offDaysRaw = ('0,6').split(',').map(s=>parseInt(s.trim(),10)).filter(n=>!isNaN(n));\nconst year=batchConfig.target_year, month=batchConfig.target_month;\nconst daysInMonth=new Date(year,month+1,0).getDate();\nconst monthName=batchConfig.target_month_name;\nconst isFirstCalendar=(brand.total_calendars_generated||0)===0;\nconst now=new Date();\nconst startDay=(batchConfig.is_partial&&batchConfig.partial_start_date)?parseInt(batchConfig.partial_start_date.split('-')[2],10):(batchConfig.start_day||now.getDate());\nlet cursor=new Date(year,month,startDay);\nconst monthEnd=new Date(year,month+1,0);\nconst scheduleDates=[];\nconst totalPosts=batchConfig.total_posts||batchConfig.expected_posts_per_brand||20;\nconst peakHours=[8,11,12,13,14,15,17,18,19,20,21,12,13,17,18,19,20,12,17,19];\nwhile(scheduleDates.length<totalPosts&&cursor<=monthEnd){\n  const dow=cursor.getDay();\n  if(!offDaysRaw.includes(dow)){\n    const yyyy=cursor.getFullYear(),mm=String(cursor.getMonth()+1).padStart(2,'0'),dd=String(cursor.getDate()).padStart(2,'0');\n    const hour=peakHours[scheduleDates.length];\n    const slotISO=`${yyyy}-${mm}-${dd}T${String(hour).padStart(2,'0')}:00:00+03:00`;\n    if(new Date(slotISO)>now) scheduleDates.push({date:`${yyyy}-${mm}-${dd}`,hour,posting_time:slotISO,is_video_slot:false});\n  }\n  cursor.setDate(cursor.getDate()+1);\n}\n\n// ── Video slot distribution ─────────────────────────────────────────────────\nconst tier = (brand.tier||'free').toLowerCase();\nlet videoCount = 0;\nif(tier==='pro'){\n  // Count full weeks remaining from startDay to monthEnd\n  const msPerWeek = 7*24*60*60*1000;\n  const startDate = new Date(year, month, startDay);\n  const remainingMs = monthEnd.getTime() - startDate.getTime();\n  videoCount = Math.max(1, Math.round(remainingMs / msPerWeek));\n  videoCount = Math.min(videoCount, scheduleDates.length);\n} else {\n  // Free: 1 video per 8 posts\n  videoCount = Math.floor(scheduleDates.length / 8);\n}\n// Evenly distribute video slots across schedule_dates\nif(videoCount > 0 && scheduleDates.length > 0){\n  const step = Math.floor(scheduleDates.length / videoCount);\n  for(let v=0;v<videoCount;v++){\n    const idx = Math.min(v * step + Math.floor(step/2), scheduleDates.length-1);\n    scheduleDates[idx].is_video_slot = true;\n  }\n}\n\nconst SAUDI_OCCASIONS={\n  'January':{occasions:['pre_ramadan_warmup'],engagement_multiplier:1.0,themes:['winter_warmth','comfort_food','family_dining','hot_beverages','qahwa'],avoid:[]},\n  'February':{occasions:['ramadan_2026','founding_day'],engagement_multiplier:2.8,ramadan:true,themes:['iftar_specials','suhoor_menu','saudi_heritage_food','founding_day_pride','family_gathering','generosity'],avoid:['daytime_food_photos','alcohol_adjacent','western_valentine_push']},\n  'March':{occasions:['ramadan_end_2026','eid_al_fitr_2026'],engagement_multiplier:2.5,ramadan:true,eid:true,themes:['eid_celebration','family_feast','sweets_gifting','eid_menu_launch','joy_togetherness'],avoid:[]},\n  'April':{occasions:['post_eid_spring','mothers_day_arab'],engagement_multiplier:1.2,themes:['outdoor_dining','spring_freshness','light_menu','mothers_day_dining','dates_culture'],avoid:[]},\n  'May':{occasions:['eid_al_adha_2026','hajj_season_2026'],engagement_multiplier:2.2,eid:true,themes:['meat_grills','mandi','kabsa','family_feast','eid_adha_special','sacrifice_generosity','bbq_grills'],avoid:['heavy_vegetarian_push','pork_adjacent']},\n  'June':{occasions:['summer_start','saudi_summer_program'],engagement_multiplier:1.0,themes:['cooling_drinks','fresh_juices','indoor_comfort','refreshing_desserts','iced_coffee','summer_specials'],avoid:['outdoor_heat_photos','heavy_meat_content']},\n  'July':{occasions:['saudi_summer_festival','school_vacation_peak'],engagement_multiplier:1.1,themes:['family_entertainment','kids_meal','ice_cream','cold_beverages','mall_dining','fun_moments'],avoid:['formal_corporate_tone']},\n  'August':{occasions:['back_to_school_prep','late_summer'],engagement_multiplier:1.0,themes:['quick_bites','student_deals','family_prep','comfort_food','affordable_options'],avoid:[]},\n  'September':{occasions:['national_day','back_to_school'],engagement_multiplier:1.9,themes:['saudi_pride','traditional_saudi_cuisine','green_gold_colors','heritage_dishes','kabsa','mandi','jareesh','harees','national_day_offer'],avoid:['non_saudi_cultural_references','western_themed_content']},\n  'October':{occasions:['world_coffee_day','world_food_day','fall_season'],engagement_multiplier:1.3,themes:['arabic_coffee','qahwa_culture','seasonal_warmth','autumn_menu','food_story','behind_scenes','artisan_quality'],avoid:[]},\n  'November':{occasions:['pre_winter_season','saudi_entertainment_season'],engagement_multiplier:1.2,themes:['warm_beverages','hearty_meals','cozy_ambiance','traditional_soups','shorbah','warm_tone'],avoid:[]},\n  'December':{occasions:['winter_peak','riyadh_season','year_end'],engagement_multiplier:1.4,themes:['year_end_gratitude','family_gatherings','winter_warmth','special_menu','gifting_sweets','premium_experience','year_review'],avoid:['christmas_themes_for_conservative_brands','new_year_party_content']}\n};\nconst monthData=SAUDI_OCCASIONS[monthName]||{occasions:[],engagement_multiplier:1.0,themes:[],avoid:[]};\nreturn [{ json:{\n  brand_id:brand.brand_id,brand_name_ar:brand.brand_name_ar,brand_name_en:brand.brand_name_en||brand.brand_name_ar,\n  sector:brand.sector,arabic_dialect:brand.arabic_dialect,city:brand.city_primary,tier:brand.tier,\n  total_calendars:brand.total_calendars_generated||0,primary_channel:brand.primary_channel||'Instagram',\n  religious_sensitivity:brand.religious_sensitivity||'High',price_position:brand.price_position||'mid_market',\n  ramadan_relevance:brand.ramadan_relevance||'High',bilingual_ratio:brand.bilingual_ratio||'arabic_primary',\n  month:monthName,month_key:year+'-'+String(month+1).padStart(2,'0'),year,days_in_month:daysInMonth,\n  posts_per_week:7-offDaysRaw.length,total_posts:scheduleDates.length,off_days:offDaysRaw,schedule_dates:scheduleDates,\n  video_count_forced:videoCount,\n  occasions:monthData.occasions,occasion_themes:monthData.themes||[],occasion_avoid:monthData.avoid||[],\n  engagement_multiplier:monthData.engagement_multiplier||1.0,ramadan_active:monthData.ramadan||false,\n  eid_active:monthData.eid||false,is_first_calendar:isFirstCalendar,batch_id:batchConfig.batch_id,\n  is_partial:batchConfig.is_partial||false,\n  primary_color_hex:brand.primary_color_hex||'',secondary_color_hex:brand.secondary_color_hex||'',\n  brand_differentiator:brand.brand_differentiator||''\n} }];"
      },
