    {
      "parameters": {
        "jsCode": "const FALLBACK = 'https://app.openclaw.com/assets/visual-placeholder.png';\n\n// Get all inputs from both branches\nconst originalPosts = $('IF: Video or Image?1').all().map(item => item.json);\nconst visualResults = $(\"Call Return success to parent'\").all().map(item => item.json);\n\n// Create a map of visual results by post_id\nconst visualMap = new Map();\nvisualResults.forEach(result => {\n  if (result.post_id) {\n    visualMap.set(result.post_id, result);\n  }\n});\n\n// Merge the data\nconst mergedResults = originalPosts.map((post) => {\n  // Get visual result by post_id\n  const visual = visualMap.get(post.post_id) || {};\n  \n  const storage_url = visual.storage_url || null;\n  const visual_failed = !storage_url;\n  const looksExternal = storage_url && !/supabase\\.co\\/storage\\/v1\\/object\\/public\\//i.test(storage_url);\n  \n  return {\n    json: {\n      // Original post data\n      post_id: post.post_id,\n      brand_id: post.brand_id,\n      calendar_id: post.calendar_id,\n      caption_ar: post.caption_ar,\n      posting_time: post.posting_time,\n      content_type: post.content_type,\n      hashtags: post.hashtags,\n      position: post.position,\n      confidence_score: post.confidence_score,\n      cco_score: post.cco_score,\n      route: post.route,\n      flags: post.flags,\n      trigger_reason: post.trigger_reason,\n      format_tier: post.format_tier,\n      brave_route_flag: post.brave_route_flag,\n      negpat_flag: post.negpat_flag,\n      \n      // Visual generation results\n      storage_url: (looksExternal || visual_failed) ? FALLBACK : storage_url,\n      clean_storage_url: visual.clean_storage_url || null,\n      visual_failed: visual_failed || looksExternal,\n      visual_generation_success: visual.success || false,\n      \n      // Updated status fields\n      status: (visual_failed || looksExternal) ? 'draft' : (post.status || 'draft'),\n      watermark: (visual_failed || looksExternal) ? true : (post.watermark || false)\n    }\n  };\n});\n\nreturn mergedResults;"
      },
