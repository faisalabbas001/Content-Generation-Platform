      "parameters": {
        "jsCode": "// Split schedule_dates into chunks of 5 for DeepSeek batching.\nconst brandData = $('Prepare Brand Data').first().json;\nconst CHUNK_SIZE = 5;\nconst dates = brandData.schedule_dates || [];\nconst chunks = [];\nfor (let i = 0; i < Math.max(dates.length, 1); i += CHUNK_SIZE) {\n  const slice = dates.slice(i, i + CHUNK_SIZE);\n  chunks.push({ json: {\n    ...brandData,\n    schedule_dates: slice,\n    post_count_chunk: slice.length,\n    chunk_index: Math.floor(i / CHUNK_SIZE),\n    chunk_total: Math.ceil(Math.max(dates.length, 1) / CHUNK_SIZE),\n    chunk_start: i\n  }});\n}\nreturn chunks;"
      },
      "id": "0da61111-5cfd-4e56-8124-3ce50f19d6cc",
      "name": "Split Into Chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -98752,
        -15088
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Merge all DeepSeek chunk responses into one unified posts array.\n// Handles partial failures: chunks that errored produce no .result.posts,\n// so we skip those silently and merge only what succeeded.\nconst allItems = $input.all();\nconst merged   = [];\nlet failedChunks = 0;\n\nfor (const item of allItems) {\n  const r = item.json || {};\n  // Success path: result.posts array present\n  const posts = Array.isArray(r.result?.posts) ? r.result.posts\n    // Error path: some APIs return posts at top level\n    : Array.isArray(r.posts) ? r.posts\n    : [];\n  if (posts.length === 0) failedChunks++;\n  merged.push(...posts);\n}\n\nconst first = allItems[0] ? allItems[0].json : {};\n\n// If every single chunk failed, return a sentinel so downstream\n// nodes (Merge Posts Data1) can detect the failure and route to QA.\nif (merged.length === 0) {\n  return [{ json: {\n    ...first,\n    result: { posts: [] },\n    _deepseek_total_failed: true,\n    _failed_chunks: failedChunks,\n    _all_chunks: allItems.length\n  } }];\n}\n\nreturn [{ json: {\n  ...first,\n  result: { posts: merged },\n  _failed_chunks: failedChunks,\n  _total_posts_collected: merged.length\n} }];"
      },
