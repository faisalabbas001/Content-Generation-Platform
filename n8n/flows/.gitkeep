    {
      "parameters": {
        "jsCode": "const brandData=$('Prepare Brand Data').first().json;\nlet confMode=null;\ntry{confMode=$('Call: CEO Route & Classify').first().json.result?.decision?.confidence_mode;}catch(_){}\nconst baseSummary={brand_id:brandData.brand_id,brand_name_ar:brandData.brand_name_ar,client_slug:brandData.client_slug,client_email:brandData.client_email,month:brandData.month,month_key:brandData.month_key,batch_id:brandData.batch_id,batch_shard:brandData.batch_shard,completed_at:new Date().toISOString()};\nif(confMode==='Blocked') return [{json:{...baseSummary,status:'blocked',skip_reason:'confidence_mode_blocked',posts_generated:0,posts_clean:0,posts_watermarked:0,posts_held:0,visual_fallbacks:0}}];\nif(!brandData.arabic_dialect) return [{json:{...baseSummary,status:'skipped',skip_reason:'dialect_not_confirmed',posts_generated:0,posts_clean:0,posts_watermarked:0,posts_held:0,visual_fallbacks:0}}];\nconst allPosts=$('Merge Posts Data1').all().map(i=>i.json||{});\nlet visualPosts=[];\ntry{visualPosts=$('Merge Visual Results1').all().map(i=>i.json||{});}catch(_){}\nconst visualFailures=visualPosts.filter(p=>p.visual_failed).length;\nreturn [{json:{...baseSummary,status:'complete',posts_generated:allPosts.length,posts_clean:allPosts.filter(p=>p.route==='CLEAN').length,posts_watermarked:allPosts.filter(p=>p.route==='WATERMARK').length,posts_held:allPosts.filter(p=>p.route==='HOLD').length,visual_fallbacks:visualFailures}}];"
      },
      "id": "b97cfc33-bfe1-48ca-9bc3-d21fd7e5d811",
      "name": "Brand Summary1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -90256,
        -13776
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const httpRequest = async ({method='GET', url, headers={}, body, timeout=60000}) => {\n  // n8n Code-node safe HTTP (fetch is not available in the sandbox).\n  // Faithful to the old fetch helper: return the parsed body for ANY HTTP status,\n  // throw only on network/timeout (so retry loops behave as before).\n  const resp = await this.helpers.httpRequest({ method, url, headers, body, timeout, json: false, returnFullResponse: true, ignoreHttpStatusErrors: true });\n  const text = resp && typeof resp === 'object' && 'body' in resp ? resp.body : resp;\n  if (typeof text !== 'string') return text;\n  try { return JSON.parse(text); } catch (_) { return text; }\n};\n// Collect all visual results for this brand and write them to calendar_posts in ONE call.\n// Then pass through to Loop Brands so the next brand starts.\nlet posts = [];\ntry {\n  posts = $('Merge Visual Results1').all().map(item => {\n    const p = item.json || {};\n    return {\n      calendar_id: p.calendar_id, post_id: p.post_id, brand_id: p.brand_id,\n      position: p.position, caption_ar: p.caption_ar, storage_url: p.storage_url,\n      posting_time: p.posting_time, content_type: p.content_type, hashtags: p.hashtags,\n      confidence_score: p.confidence_score, status: p.status, watermark: p.watermark,\n      route_decision: (p.route||'clean').toLowerCase()\n    };\n  }).filter(p => p.calendar_id && p.post_id);\n} catch(_) {}\n\nif (posts.length > 0) {\n  try {\n    await httpRequest({\n      method: 'POST',\n      url: 'https://redzmrlzhxkkpgcokgvl.supabase.co/rest/v1/calendar_posts?on_conflict=calendar_id,position',\n      headers: { apikey:'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJlZHptcmx6aHhra3BnY29rZ3ZsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzUzMDE5MiwiZXhwIjoyMDkzMTA2MTkyfQ.JK_Vctncdz90VUxnRXVnwysl6P6XgKbJ2-a5Zf3qgpo', Authorization:'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJlZHptcmx6aHhra3BnY29rZ3ZsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzUzMDE5MiwiZXhwIjoyMDkzMTA2MTkyfQ.JK_Vctncdz90VUxnRXVnwysl6P6XgKbJ2-a5Zf3qgpo',\n                 'Content-Type':'application/json', Prefer:'resolution=merge-duplicates,return=minimal' },\n      body: JSON.stringify(posts), timeout: 15000\n    });\n  } catch(_) {} // non-fatal — per-post inserts in loop already ran as fallback\n}\n\n// Pass a minimal summary forward (Brand Summary1 reads from other nodes directly)\nreturn [{ json: { bulk_saved: posts.length, brand_id: posts[0]?.brand_id || null } }];"
      },
      "id": "38e48f5b-bafc-455f-836e-409511e10268",
      "name": "Bulk Save & Advance Brand",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -89744,
        -13776
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// COO timed out or errored — build a minimal caption_context from brand_profiles data.\n// This lets DeepSeek still run with a reduced (but valid) context instead of skipping the brand.\nconst brandData = $('Prepare Brand Data').first().json;\n\nconst fallbackContext = [\n  `Brand: ${brandData.brand_name_ar} (${brandData.brand_name_en || brandData.brand_name_ar})`,\n  `Sector: ${brandData.sector || 'F&B'}`,\n  `Dialect: ${brandData.arabic_dialect || 'saudi'}`,\n  `City: ${brandData.city || 'Riyadh'}`,\n  `Channel: ${brandData.primary_channel || 'Instagram'}`,\n  `Religious Sensitivity: ${brandData.religious_sensitivity || 'High'}`,\n  `Price Position: ${brandData.price_position || 'mid_market'}`,\n  `Month: ${brandData.month} ${brandData.year}`,\n  `Occasions: ${(brandData.occasions||[]).join(', ') || 'none'}`,\n  `Themes: ${(brandData.occasion_themes||[]).slice(0,5).join(', ')}`,\n  `Avoid: ${(brandData.occasion_avoid||[]).join(', ') || 'none'}`,\n  '',\n  'Tone: Warm, authentic, culturally resonant. Use appropriate Arabic dialect.',\n  'Content mix: 30% emotional, 20% lifestyle, 20% offer, 10% educational, 10% testimonial, 10% announcement.',\n  'Hashtags: Use 5-8 per post, mix Arabic and English, brand-specific + trending Saudi F&B tags.',\n  'Always: Proper Arabic grammar, no romanized Arabic, culturally appropriate imagery descriptions.',\n].join('\\n');\n\nreturn [{ json: {\n  result: {\n    caption_context: fallbackContext,\n    dialect_confirmed: true,\n    watermark_flag: false,\n    _coo_fallback: true\n  }\n} }];"
      },
      "id": "fbb1d9a5-145d-45fc-ae81-21e42542dc19",
      "name": "COO Fallback: Use Brand Bio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -99456,
        -15040
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst SECRET='c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887';\nconst makeUUID=()=>'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.random()*16|0;return(c==='x'?r:(r&0x3|0x8)).toString(16);});\nconst isWorkflowLevel=!!($json.execution||$json.workflow);\nlet brand_id=null,brand_name_ar=null;\ntry{const bd=$('Prepare Brand Data').first().json;brand_id=bd.brand_id??null;brand_name_ar=bd.brand_name_ar??null;}catch(_){}\nlet payload,source;\nif(isWorkflowLevel){\n  source='workflow_error';const e=$json;\n  payload={anomaly_id:makeUUID(),anomaly_type:'batch_calendar_failed',severity:'error',source_flow:'N8N-A01',brand_id,message:e.execution?.error?.message||'A01 batch calendar flow failed',details:{failed_node:e.execution?.lastNodeExecuted??null,error_name:e.execution?.error?.name??null,execution_id:e.execution?.id??null},timestamp:new Date().toISOString()};\n}else{\n  source='per_brand';const errInfo=$json.error||$json;const failed=errInfo.node?.name||errInfo.nodeName||$execution.lastNodeExecuted||null;\n  payload={anomaly_id:makeUUID(),anomaly_type:'agent_call_failed',severity:'warning',source_flow:'N8N-A01',brand_id,brand_name_ar,message:errInfo.message||'AI agent HTTP call failed after retries',details:{failed_node:failed,error_name:errInfo.name||errInfo.errorName||null,http_code:errInfo.httpCode||errInfo.statusCode||null,execution_id:$execution.id},timestamp:new Date().toISOString()};\n}\nconst body=JSON.stringify(payload);\nconst sig=crypto.createHmac('sha256',SECRET).update(body).digest('hex');\nreturn [{ json:{ _body:body,_headers:{'content-type':'application/json','x-n8n-signature':sig,'x-n8n-request-id':`${$execution.id}-${source}-a01`,'x-n8n-timestamp':new Date().toISOString()},brand_id,failed_node:payload.details.failed_node,error_name:payload.details.error_name||null,error_message:payload.message,http_code:payload.details.http_code||null,source } }];"
      },
      "id": "431d84bc-1eb8-4f69-8a70-c20d0b25141f",
