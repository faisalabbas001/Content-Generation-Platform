      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Jitter: stagger parallel brand calls to avoid thundering herd on DeepSeek\nconst _chunkIdx = $json.chunk_index || 0;\nconst _brandPos = (() => { try { return $('Loop Brands (5 Parallel)').context?.currentRunIndex || 0; } catch(_){ return 0; } })();\nawait new Promise(r => setTimeout(r, (_brandPos % 5) * 300 + _chunkIdx * 80 + Math.floor(Math.random()*100)));\n\nconst crypto    = require('crypto');\nconst brandData = $json;\nconst secret    = 'c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887';\nconst requestId = crypto.randomUUID();\nconst timestamp = new Date().toISOString();\n\n// Read COO context from success path or fallback path, with inline guard\nlet cooResult = {};\ntry { cooResult = $('Call: COO Build CaptionContext').first().json?.result || {}; } catch(_) {}\nif (!cooResult.caption_context) {\n  try { cooResult = $('COO Fallback: Use Brand Bio').first().json?.result || {}; } catch(_) {}\n}\nif (!cooResult.caption_context || cooResult.caption_context.trim().length < 10) {\n  cooResult.caption_context = [\n    'Brand: '+(brandData.brand_name_ar||'')+' ('+(brandData.brand_name_en||'')+')',\n    'Sector: '+(brandData.sector||'F&B'), 'Dialect: '+(brandData.arabic_dialect||'saudi'),\n    'Month: '+(brandData.month||'')+' '+(brandData.year||''),\n    'Occasions: '+(brandData.occasions||[]).join(', '),\n    'Tone: Authentic, warm, culturally resonant. Proper Arabic grammar only.',\n    'Mix: 30% emotional, 20% lifestyle, 20% offer, 10% educational, 10% testimonial, 10% announcement.'\n  ].join('\\n');\n}\n\nconst MAX_CHARS = 4000;\nlet context = cooResult.caption_context;\nconst contextTruncated = context.length > MAX_CHARS;\nif (contextTruncated) context = context.slice(0, MAX_CHARS) + '\\n[…context truncated…]';\n\nconst occasionContext = (brandData.occasions&&brandData.occasions.length>0&&brandData.occasions[0]!=='none')\n  ? { name:brandData.occasions[0], all:brandData.occasions, themes:(brandData.occasion_themes||[]).slice(0,6),\n      avoid:(brandData.occasion_avoid||[]).slice(0,6), lead_weeks:1,\n      priority: brandData.engagement_multiplier>=2.0?'Critical':'Normal' }\n  : undefined;\n\nconst body = JSON.stringify({\n  flow_id:'N8N-A01', brand_id:brandData.brand_id,\n  payload:{\n    month: brandData.month_key, caption_context: context, context_truncated: contextTruncated,\n    post_count: brandData.post_count_chunk||brandData.total_posts||5,\n    schedule_dates: brandData.schedule_dates||[],\n    start_date: brandData.schedule_dates?.[0]?.date || brandData.month_key+'-01',\n    off_days: brandData.off_days||[5,6], platform: brandData.primary_channel||'Instagram',\n    dialect: brandData.arabic_dialect, bilingual_ratio: brandData.bilingual_ratio,\n    ...(occasionContext ? { occasion_context: occasionContext } : {}),\n    watermark_required: cooResult.watermark_flag||false,\n    system_enhancement: \"CRITICAL: Strictly follow caption_context. For each post output ALL fields: 'visual_brief_en' (detailed English image generation prompt), 'sharp_text_gravity', 'font_color', 'font_size', 'gravity_rationale', 'posting_time_rationale'.\"\n  }\n});\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nconst _base = 'https://unwieldable-mavis-unbacked.ngrok-free.dev';\nreturn [{ json: {\n  _url: _base + '/api/agents/deepseek/generate',\n  _body: body,\n  _headers: {\n    'content-type':'application/json','x-n8n-signature':signature,\n    'x-n8n-request-id':requestId,'x-n8n-timestamp':timestamp,\n    'Authorization':'Bearer sk-cdb54723c86f4667a7173d2f1e391975'\n  }\n}}];"
      },
