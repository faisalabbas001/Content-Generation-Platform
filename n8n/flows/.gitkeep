      "parameters": {
        "jsCode": "// Reconstruct EXACT original \"Call: Match Chain\" fallback semantics.\n// POST node has neverError:true so non-2xx bodies arrive on SUCCESS and pass through verbatim.\n// Only true network/timeout failures hit the error output and trigger the skip-fallback.\nconst item = $input.first().json || {};\nlet _deepseek_posts = [];\ntry { _deepseek_posts = item._deepseek_posts || $('Sign · Match Chain').first().json._deepseek_posts || []; } catch(_) { _deepseek_posts = item._deepseek_posts || []; }\nconst hadError = !!item.error;\nlet resp;\nif (hadError) {\n  resp = { result: { posts: _deepseek_posts }, _match_skipped: true, _deepseek_posts };\n} else {\n  const apiJson = { ...item };\n  delete apiJson._deepseek_posts;\n  delete apiJson._url; delete apiJson._body; delete apiJson._headers;\n  resp = apiJson;\n  resp._deepseek_posts = _deepseek_posts;\n}\nreturn [{ json: resp }];"
      },
