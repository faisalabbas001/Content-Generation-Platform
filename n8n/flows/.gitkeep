    {
      "parameters": {
        "jsCode": "const httpRequest = async ({method='GET', url, headers={}, body, timeout=60000}) => {\n  // n8n Code-node safe HTTP (fetch is not available in the sandbox).\n  // Faithful to the old fetch helper: return the parsed body for ANY HTTP status,\n  // throw only on network/timeout (so retry loops behave as before).\n  const resp = await this.helpers.httpRequest({ method, url, headers, body, timeout, json: false, returnFullResponse: true, ignoreHttpStatusErrors: true });\n  const text = resp && typeof resp === 'object' && 'body' in resp ? resp.body : resp;\n  if (typeof text !== 'string') return text;\n  try { return JSON.parse(text); } catch (_) { return text; }\n};\nconst post=$json;\nif(post.calendar_id&&post.post_id){\n  try{\n    const SK='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJlZHptcmx6aHhra3BnY29rZ3ZsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzUzMDE5MiwiZXhwIjoyMDkzMTA2MTkyfQ.JK_Vctncdz90VUxnRXVnwysl6P6XgKbJ2-a5Zf3qgpo';\n    await httpRequest({\n      method:'POST',url:'https://redzmrlzhxkkpgcokgvl.supabase.co/rest/v1/calendar_posts?on_conflict=calendar_id,position',\n      headers:{apikey:SK,Authorization:'Bearer '+SK,Prefer:'resolution=merge-duplicates','Content-Type':'application/json'},\n      body:JSON.stringify({calendar_id:post.calendar_id,post_id:post.post_id,brand_id:post.brand_id,position:post.position,caption_ar:post.caption_ar,posting_time:post.posting_time,content_type:post.content_type||'emotional',hashtags:post.hashtags||[],confidence_score:post.confidence_score,status:'held',watermark:post.watermark||false,route_decision:'hold'})\n    });\n  }catch(e){console.error('Insert Hold Post1 failed:',e.message||e);}\n}\nreturn [{ json:post }];"
      },
