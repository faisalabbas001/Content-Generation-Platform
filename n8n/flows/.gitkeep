    {
      "parameters": {
        "jsCode": "const crypto   = require('crypto');\nconst brandData = $('Prepare Brand Data').first().json;\nconst ceoResult = $('Call: CEO Route & Classify').first().json?.result || {};\nconst decision  = ceoResult.decision || {};\nconst secret    = 'c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887';\nconst requestId = crypto.randomUUID();\nconst timestamp = new Date().toISOString();\n\nconst contentMix = brandData.ramadan_active\n  ? { emotional:0.4, lifestyle:0.2, offer:0.2, educational:0.05, testimonial:0.05, announcement:0.1 }\n  : brandData.eid_active\n  ? { emotional:0.35, lifestyle:0.15, offer:0.25, educational:0.05, testimonial:0.1, announcement:0.1 }\n  : { emotional:0.3, lifestyle:0.2, offer:0.2, educational:0.1, testimonial:0.1, announcement:0.1 };\n\nconst body = JSON.stringify({\n  flow_id: 'N8N-A01', brand_id: brandData.brand_id,\n  payload: {\n    confidence_mode: decision.confidence_mode||'Standard',\n    occasion_flags:  (decision.occasion_flags&&decision.occasion_flags.length>0) ? decision.occasion_flags : ['none'],\n    platform_spec:   brandData.primary_channel||'Instagram',\n    content_mix:     contentMix,\n    post_count:      brandData.total_posts||20,\n    brand: {\n      brand_id: brandData.brand_id, brand_name_ar: brandData.brand_name_ar,\n      brand_name_en: brandData.brand_name_en, sector: brandData.sector,\n      arabic_dialect: brandData.arabic_dialect, city: brandData.city,\n      religious_sensitivity: brandData.religious_sensitivity, price_position: brandData.price_position,\n      ramadan_relevance: brandData.ramadan_relevance, bilingual_ratio: brandData.bilingual_ratio,\n      month: brandData.month_key, occasions: brandData.occasions,\n      occasion_themes: brandData.occasion_themes||[], occasion_avoid: brandData.occasion_avoid||[],\n      engagement_multiplier: brandData.engagement_multiplier||1.0,\n      ramadan_active: brandData.ramadan_active||false, eid_active: brandData.eid_active||false,\n      schedule_dates: brandData.schedule_dates\n    },\n    negative_patterns: [], cost_constraint: decision.cost_status||'normal'\n  }\n});\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nconst _base = 'https://unwieldable-mavis-unbacked.ngrok-free.dev';\nreturn [{ json: {\n  _url: _base + '/api/agents/coo/compile-caption-context',\n  _body: body,\n  _headers: {\n    'content-type': 'application/json', 'x-n8n-signature': signature,\n    'x-n8n-request-id': requestId, 'x-n8n-timestamp': timestamp,\n    'x-api-key': 'REDACTED_ANTHROPIC_KEY', 'anthropic-version': '2023-06-01'\n  }\n}}];"
      },
