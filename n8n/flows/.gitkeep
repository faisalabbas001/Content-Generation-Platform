    {
      "parameters": {
        "jsCode": "const crypto    = require('crypto');\nconst brandData  = $('Prepare Brand Data').first().json;\nconst deepseekPosts = ($input.first().json?.result?.posts || []).map(p => ({\n  post_id: p.post_id,\n  visual_brief_en: (p.visual_brief_en||p.prompt_en||'').slice(0,300),\n  content_type: p.content_type||'emotional',\n  format: p.format||'image',\n  offer_type: p.offer_type||null\n}));\nconst secret    = 'c56cb3e88c57ea77929fdbec379fb6ff1ab72fef61cee9084e9cb263892d8887';\nconst requestId = crypto.randomUUID();\nconst timestamp = new Date().toISOString();\nconst body = JSON.stringify({\n  flow_id:'N8N-A01', brand_id:brandData.brand_id,\n  payload:{ posts:deepseekPosts, sector:brandData.sector,\n            occasions:brandData.occasions||[], primary_channel:brandData.primary_channel||'Instagram',\n            month:brandData.month_key }\n});\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nconst _deepseek_posts = $input.first().json?.result?.posts || [];\nconst _base = 'https://unwieldable-mavis-unbacked.ngrok-free.dev';\nreturn [{ json: {\n  _deepseek_posts,\n  _url: _base + '/api/agents/ceo/match-chain',\n  _body: body,\n  _headers: {\n    'content-type': 'application/json',\n    'x-n8n-signature': signature,\n    'x-n8n-request-id': requestId,\n    'x-n8n-timestamp': timestamp\n  }\n}}];"
      },
