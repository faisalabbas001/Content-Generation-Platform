    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst brandData=$('Prepare Brand Data').first().json;\nconst matchResult=$('Call: Match Chain').first().json||{};\nconst posts_raw=(matchResult.result?.posts)||(matchResult.posts)||($('Call: DeepSeek Generate').first().json?.result?.posts)||[];\nconst ccoResult=$('Call: CCO Quality Check').first().json.result||[];\nconst ceoResult=$('Call: CEO Confidence Gate').first().json.result||{};\nconst human_gate=(ceoResult.decision&&ceoResult.decision.human_gate_required)||false;\nconst confidence_mode=$('Call: CEO Route & Classify').first().json.result?.decision?.confidence_mode||'Standard';\nconst holdThreshold=confidence_mode==='Cautious'?65:50;\nconst isMinimal=confidence_mode==='Minimal';\nconst brand_first_calendar=brandData.is_first_calendar===true;\nconst brand_govt_hold=(brandData.sector||'').toLowerCase()==='government';\nlet planSlots=[];\ntry{ const ps=$('Call: Plan Slots').first().json||{}; planSlots=(ps.result||ps).slots||[]; } catch(_){}\nconst _calRaw=$input.first().json;\nconst calendarInput=Array.isArray(_calRaw)?_calRaw[0]:_calRaw;\nconst calendarId=calendarInput?.calendar_id||calendarInput?.id||null;\nconst scheduleDates=brandData.schedule_dates||[];\nfunction getOccasionVisualMotif(occasions){\n  if(!occasions||occasions.length===0) return 'celebratory motion';\n  const o=occasions[0];\n  if(o==='ramadan') return 'warm spiritual motif with crescent and lanterns';\n  if(o==='eid_al_fitr'||o==='eid_al_adha') return 'joyful celebratory motif with stars and lights';\n  if(o==='national_day') return 'patriotic motif with green and gold, Saudi flag elements';\n  if(o==='founding_day') return 'heritage motif with traditional architecture and maps';\n  return 'celebratory motion';\n}\nreturn posts_raw.map((caption,index)=>{\n  const slot=planSlots[index]||{};\n  const scheduled=scheduleDates[index]||{};\n  // format_tier: forced by is_video_slot from Prepare Brand Data, then plan slots, then DeepSeek format\n  const forced_video = scheduled.is_video_slot === true;\n  const format_tier = forced_video ? 'video' : (slot.format||slot.format_tier||caption.format||'image');\n  const selected_chain=slot.chain_id||caption.chain_id||null;\n  const score_obj=Array.isArray(ccoResult)?ccoResult.find(s=>s.post_id===caption.post_id)||{}:{};\n  const score_val=typeof score_obj.score==='number'?score_obj.score:75;\n  let route,brand_hold_reason=null;\n  if(brand_first_calendar){route='HOLD';brand_hold_reason='first_calendar_hold';}\n  else if(brand_govt_hold){route='HOLD';brand_hold_reason='government_sector_hold';}\n  else if(human_gate||score_obj.negpat_flag==='HARD_BLOCK') route='HOLD';\n  else if(isMinimal) route=score_val<75?'HOLD':'WATERMARK';\n  else if(score_val<holdThreshold) route='HOLD';\n  else if(score_val<75||score_obj.negpat_flag==='STRONG_WARN') route='WATERMARK';\n  else route='CLEAN';\n  const postingTime=scheduled.posting_time||caption.posting_time;\n  const post_id=crypto.randomUUID();\n  const sharp_grav=caption.sharp_text_gravity||'south';\n  const font_color=caption.font_color||'#FFFFFF';\n  const font_size=caption.font_size||48;\n  const visual_brief=caption.visual_brief_en||(brandData.brand_name_en+' product Saudi Arabia');\n  const product_descriptor=brandData.brand_differentiator||brandData.brand_name_en||'product';\n  const occasion_visual_motif=format_tier==='video'?getOccasionVisualMotif(brandData.occasions):null;\n  const brand_color_palette=format_tier==='video'?`${brandData.primary_color_hex||'#000000'} and ${brandData.secondary_color_hex||'#ffffff'}`:null;\n  const CHAIN_FAMILY_MAP={U01:'TF01',F01:'TF04'};\n  const chain_family=(selected_chain&&(CHAIN_FAMILY_MAP[selected_chain]||String(selected_chain).split(/[_-]/)[0].toUpperCase()))||'';\n  const cultural_constraints=brandData.sector==='F&B'?'no faces, avoid left hand':'modest, culturally appropriate, no faces';\n  const occasion=(brandData.occasions&&brandData.occasions[0]&&brandData.occasions[0]!=='none')?brandData.occasions[0]:'';\n  const base={\n    post_id,external_post_id:caption.post_id,calendar_id:calendarId,chain_id:selected_chain,\n    caption_ar:caption.caption_ar,posting_time:postingTime,content_type:caption.content_type||'emotional',\n    hashtags:caption.hashtags||[],visual_brief_en:visual_brief,position:index+1,confidence_score:score_val,\n    status:route==='CLEAN'?'generated':'draft',watermark:route==='WATERMARK',\n    dialect_flag:score_obj.dialect_flag||false,negpat_flag:score_obj.negpat_flag||'NONE',\n    cultural_flag:score_obj.cultural_flag||false,brave_route_flag:score_obj.brave_route_flag||false,\n    route,sharp_text_gravity:sharp_grav,brand_id:brandData.brand_id,brand_name_ar:brandData.brand_name_ar,\n    dialect:brandData.arabic_dialect,month:brandData.month,year:brandData.year,font_color,font_size,\n    gravity_rationale:caption.gravity_rationale||null,posting_time_rationale:caption.posting_time_rationale||null,\n    format_tier,selected_chain,product_descriptor,occasion_visual_motif,brand_color_palette,\n    chain_family,cultural_constraints,occasion,brand_name_en:brandData.brand_name_en||'',\n    sector:brandData.sector||'',primary_color_hex:brandData.primary_color_hex||''\n  };\n  const visualFields={\n    prompt_en:visual_brief,channel:'Instagram',\n    objective:base.content_type==='offer'?'conversion':'awareness',\n    confidence_flag:route==='WATERMARK'?'watermark_required':'clean',\n    cost_constraint:'normal',score:score_val,originalPost:{...base}\n  };\n  const qaFields={\n    cco_score:score_val,\n    flags:{route,negpat_flag:score_obj.negpat_flag||'NONE',brave_route_flag:score_obj.brave_route_flag||false,brand_hold_reason:brand_hold_reason||null},\n    trigger_reason:brand_hold_reason?brand_hold_reason:(score_val||0)<holdThreshold?'low_score':confidence_mode!=='Standard'&&route==='HOLD'?'confidence_mode_hold':'human_gate_override'\n  };\n  return {json:{...base,...visualFields,...qaFields}};\n});"
      },
