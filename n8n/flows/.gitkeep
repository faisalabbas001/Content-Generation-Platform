      "id": "56ef91e6-cb40-4bdc-8b44-12b3997f67c6",
      "name": "Webhook: openclaw-batch-calendar",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -108304,
        -11408
      ],
      "webhookId": "de7cc6d0-e60c-487d-919a-1de83af8ef0c"
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst currMonth = now.getMonth();\nconst currYear  = now.getFullYear();\nconst dayOfWeek = now.getDay();\nconst monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nlet target_month = currMonth, target_year = currYear;\nlet target_month_key = target_year + '-' + String(target_month+1).padStart(2,'0');\nlet off_days = [0,6];\ntry { const raw = $vars.OFF_DAYS||''; if(raw) off_days=raw.split(',').map(n=>parseInt(n.trim(),10)).filter(n=>!isNaN(n)); } catch(_){}\nconst DOW_TO_SHARD = {0:0,1:1,2:2,3:3,4:4};\nlet batch_type  = now.getDate()===1?'MONTHLY':'WEEKLY';\nlet batch_shard = batch_type==='WEEKLY'?(DOW_TO_SHARD[dayOfWeek]??0):null;\nconst daysInMonth = new Date(currYear,currMonth+1,0).getDate();\nconst is_last_sunday = dayOfWeek===0 && (now.getDate()+7)>daysInMonth;\nlet batch_id = batch_type==='MONTHLY'?'monthly-'+target_month_key:'shard-'+batch_shard+'-'+target_month_key;\nlet month_offset=0, target_brand_id=null, is_partial=false, partial_start_date=null, webhook_occasion_flags=null;\ntry {\n  const body = $('Webhook: openclaw-batch-calendar').first().json.body||{};\n  if(body.brand_id) target_brand_id=body.brand_id;\n  if(body.batch_type) batch_type=body.batch_type;\n  if(typeof body.batch_shard==='number') batch_shard=body.batch_shard;\n  else if(batch_type==='WEEKLY') batch_shard=batch_shard??(DOW_TO_SHARD[dayOfWeek]??0);\n  batch_id=batch_type==='MONTHLY'?'monthly-'+target_month_key:'shard-'+batch_shard+'-'+target_month_key;\n  if(body.partial===true&&body.start_date){is_partial=true;partial_start_date=body.start_date;}\n  if(target_brand_id&&!body.batch_type){batch_type='MONTHLY';batch_shard=null;batch_id='monthly-'+target_month_key;}\n  if(typeof body.month_offset==='number'&&body.month_offset>=0&&body.month_offset<=2) month_offset=body.month_offset;\n  if(target_brand_id&&!is_partial&&now.getDate()>1){is_partial=true;const _y=now.getFullYear();const _m=String(now.getMonth()+1).padStart(2,'0');const _d=String(now.getDate()).padStart(2,'0');partial_start_date=_y+'-'+_m+'-'+_d;}\n  if(body.occasion_flags&&Array.isArray(body.occasion_flags)) webhook_occasion_flags=body.occasion_flags;\n} catch(e){}\nif(month_offset>0){\n  const od=new Date(target_year,target_month+month_offset,1);\n  target_month=od.getMonth(); target_year=od.getFullYear();\n  target_month_key=target_year+'-'+String(target_month+1).padStart(2,'0');\n  batch_id=batch_type==='MONTHLY'?'monthly-'+target_month_key+'-offset'+month_offset:'shard-'+batch_shard+'-'+target_month_key;\n  is_partial=false; partial_start_date=null;\n}\nreturn [{ json:{target_month,target_year,target_month_name:monthNames[target_month],target_month_key,batch_type,batch_shard,is_last_sunday,batch_id,generated_at:now.toISOString(),target_brand_id,off_days,is_partial,partial_start_date,expected_posts_per_brand:20,month_offset,max_brands_per_batch:batch_type==='MONTHLY'?500:60,webhook_occasion_flags} }];"
      },
