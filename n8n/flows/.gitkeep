    {
      "parameters": {
        "jsCode": "// On error (continueErrorOutput forwarded an error) emit sentinel {_chunk_error, result:{posts:[]}}.\n// On success pass the parsed body through unchanged.\nconst item = $input.first().json || {};\nif (item && typeof item === 'object' && item.error) {\n  let msg;\n  const e = item.error;\n  if (e && typeof e === 'object') { msg = e.message || JSON.stringify(e); } else { msg = String(e); }\n  return [{ json: { _chunk_error: msg, result: { posts: [] } } }];\n}\nif (!item || typeof item !== 'object') {\n  return [{ json: { _chunk_error: 'malformed response', result: { posts: [] } } }];\n}\nreturn [{ json: item }];"
      },
      "id": "c94274b7-1a78-4d5f-b9a3-8426d10bbf5d",
      "name": "Call: DeepSeek Generate",
      "type": "n8n-nodes-base.code",
