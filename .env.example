# OpenClaw — environment variables (Doc §2.2)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. Real secrets must NEVER appear in this file.

# ╔═══════════════════════════════════════════════════════════════╗
# ║  AI providers                                                ║
# ╚═══════════════════════════════════════════════════════════════╝
# Anthropic — used for CEO (Sonnet 4.6) + COO (Haiku 4.5).
ANTHROPIC_API_KEY=
# OpenAI — used for CCO Arabic QC.
OPENAI_API_KEY=
# Optional CCO model override. Defaults to gpt-4o until OpenAI Tier 4
# is confirmed (Doc §13.1). Set to 'gpt-5' once Tier 4 is available.
OPENAI_CCO_MODEL=
# Google AI — Gemini 2.5 Pro for CIO (Phase 2 only). Stored now to avoid
# a second migration when Phase 2 lands. DO NOT call in Phase 1.
GOOGLE_AI_API_KEY=
# DeepSeek — V3 caption generator (DeepSeek API endpoint, OpenAI-compatible).
DEEPSEEK_API_KEY=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  AI prompts (OGz-supplied, env-only per SEC-06)              ║
# ╚═══════════════════════════════════════════════════════════════╝
# In dev you can leave these blank — packages/ai/src/prompts.ts will read
# from the workspace `prompts/` folder. For staging/prod, run
# `pnpm prompts:pack` and paste the resulting KEY="..." lines into Vercel
# (use the "Multiline" toggle) or n8n credential objects.
CEO_SYSTEM_PROMPT=
COO_SYSTEM_PROMPT=
CCO_SYSTEM_PROMPT=
DEEPSEEK_SYSTEM_PROMPT=
# Visual Prompt Composer (DeepSeek V3) — composes the English fal.ai image prompt.
# Leave blank in dev (loader reads prompts/OGzStudios_VisualPrompt_Prompt_v1.md).
VISUAL_PROMPT_SYSTEM_PROMPT=
COPILOT_MANAGEMENT_PROMPT=
COPILOT_TECH_PROMPT=
COPILOT_PRODUCTION_PROMPT=
# Extraction pre-fill (Haiku 4.5) — fills the Step-3 review form defaults from
# scraped IG/Web/Places. Leave blank in dev (loader reads prompts/OpenClaw_ExtractionPrefill_Prompt_v1.md).
EXTRACTION_PREFILL_SYSTEM_PROMPT=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Image generation — fal.ai (replaces Weavy in Phase 1)       ║
# ╚═══════════════════════════════════════════════════════════════╝
# fal.ai key — used for both Flux Pro Ultra (premium) and Nano Banana (bulk).
# Get it from https://fal.ai/dashboard/keys
FAL_KEY=
# Optional model overrides. Defaults match Doc §3.3 / N8N-V01.
FAL_FLUX_MODEL=fal-ai/flux-pro/v1.1-ultra
FAL_NANO_BANANA_MODEL=fal-ai/nano-banana
# Feature flag — when 'true', n8n's per-post Visual Prompt Composer call returns
# a DeepSeek-composed brief. When anything else (or unset), the route returns an
# empty brief and n8n keeps its existing visual_brief_en (safe kill-switch).
VISUAL_PROMPT_COMPOSER_ENABLED=false

# ── DEPRECATED — left here for back-compat with old code paths ───
# These will be removed once N8N-V01 is fully migrated to fal.ai. Do not
# fill them in for new deployments.
WEAVY_API_KEY=
NANO_BANANA_API_KEY=
FLUX_ULTRA_API_KEY=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Supabase — client instance                                  ║
# ╚═══════════════════════════════════════════════════════════════╝
# Project URL, e.g. https://abcdxyz.supabase.co
# Find these under Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# SERVICE ROLE — server-side only. NEVER expose to the browser.
# Important: this MUST be the real `service_role` JWT (role claim = service_role).
# If you paste the anon key here, RLS will block all server-side writes.
SUPABASE_SERVICE_ROLE_KEY=
# DB credentials — needed for migrate/seed/verify scripts AND for the
# Memory Controller's RLS-bypass adapter (when service-role JWT isn't real).
# Either set SUPABASE_DB_PASSWORD, or paste the full Postgres URL from
# Settings → Database into SUPABASE_DB_URL (overrides the password path).
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# Next.js public vars (browser-readable — anon key is safe here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Supabase — admin instance                                   ║
# ╚═══════════════════════════════════════════════════════════════╝
# Per Doc §2.1, admin should run on a SEPARATE Supabase project to keep
# the admin auth user pool isolated from the client auth user pool.
# Phase 1 ships with a single project (set ADMIN_URL = same URL).
SUPABASE_ADMIN_URL=https://your-project-ref.supabase.co
SUPABASE_ADMIN_SERVICE_KEY=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Vectors — Qdrant Cloud                                      ║
# ╚═══════════════════════════════════════════════════════════════╝
# Used by COO for CaptionContext caching (per-brand namespaces).
# Phase 1 = free tier; Phase 2 = paid tier with dedicated nodes.
QDRANT_URL=
QDRANT_API_KEY=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Email — Resend                                              ║
# ╚═══════════════════════════════════════════════════════════════╝
# All transactional Arabic emails. Get from https://resend.com/api-keys
RESEND_API_KEY=
# Default "from" address (must be a verified domain on your Resend account).
RESEND_FROM_EMAIL=openclaw@ogz.studio

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Payments — Stripe                                           ║
# ╚═══════════════════════════════════════════════════════════════╝
# Server-side only. Webhook secret is from Stripe Dashboard → Developers
# → Webhooks → "Signing secret" for the endpoint pointing at
# /api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Analytics + scraping                                        ║
# ╚═══════════════════════════════════════════════════════════════╝
# PostHog — funnel + upgrade trigger events (server-side push).
POSTHOG_KEY=
# Optional region override; defaults to https://us.i.posthog.com.
POSTHOG_HOST=
# Apify — Instagram scraper actor used by N8N-A03 (Doc §13.1).
APIFY_API_KEY=
# IG posts to fetch per scrape (1–200). Default 50. Set to 2–3 during local
# testing to keep Apify cost minimal; bump back to 50 for production runs.
IG_POSTS_LIMIT=2
# Google Places API — used by N8N-A03 for category, rating, reviews.
GOOGLE_PLACES_API_KEY=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  n8n webhook authentication (HMAC)                           ║
# ╚═══════════════════════════════════════════════════════════════╝
# 32-byte random hex shared between Vercel (server side) and n8n
# (credential object). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for /api/webhooks/n8n AND /api/agents/* AND /api/memory/* routes.
N8N_WEBHOOK_SECRET=
# Calendar posting off-days (comma-separated JS day numbers: 0=Sun,1=Mon,...,6=Sat).
# Current client requirement: 0,6 (Sunday + Saturday off).
# KSA standard weekend would be 5,6 (Friday + Saturday).
# Set this as an n8n Variable ($vars.OFF_DAYS) in your n8n instance settings.
OFF_DAYS=0,6
# Outbound URL that triggers the on-demand single-post flow (N8N-A02).
# Example: https://n8n.example.com/webhook/openclaw-a02
N8N_WEBHOOK_URL_A02=https://ogztudios.app.n8n.cloud/webhook/openclaw-a02
# OpenClaw API origin n8n calls back into. Used inside the workflow JSON.
# Example: https://app.openclaw.ai  (in dev: http://host.docker.internal:3000)
OPENCLAW_API_BASE_URL=http://localhost:3000

# n8n Cloud webhook URL for N8N-A02 (on-demand single post).
# Format: https://xxx.app.n8n.cloud/webhook/TOKEN
# Fill this in AFTER importing N8N-A02 into n8n Cloud and activating it.
# The token is embedded in the URL — no separate HMAC needed for this outbound call.
N8N_A02_WEBHOOK_URL=
# n8n Cloud webhook URL for N8N-B03 (revision request — triggered by Request Changes button).
N8N_B03_WEBHOOK_URL=https://your-workspace.app.n8n.cloud/webhook-test/revision-request

# Optional — base URL n8n will call our routes at. Used by some helper
# scripts; the routes themselves don't read this.
N8N_BASE_URL=http://localhost:3000

# OUTBOUND — n8n cloud workspace + per-flow webhook paths used by
# triggerN8nA03Onboarding / triggerN8nA04Correction / triggerN8nA06Extraction.
# /webhook-test/... = workflow in test mode (one-shot per "Test workflow" click)
# /webhook/...      = workflow activated (no click needed; persistent)
N8N_INBOUND_URL=https://ogztudios.app.n8n.cloud
# A01 — Batch calendar generation. Triggered on strategy-review "Approve & Generate".
N8N_A01_BATCH_CALENDAR_WEBHOOK_PATH=/webhook/openclaw-batch-calendar
N8N_A03_WEBHOOK_PATH=/webhook-test/openclaw-onboarding
N8N_A04_WEBHOOK_PATH=/webhook-test/openclaw-correction
N8N_A06_WEBHOOK_PATH=/webhook-test/openclaw-extraction
# N8N-S03 anomaly router webhook — use /webhook-test/... while in test mode, /webhook/... when activated
N8N_S03_WEBHOOK_URL=https://ogztudios.app.n8n.cloud/webhook-test/anomaly-alert

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Admin access                                                ║
# ╚═══════════════════════════════════════════════════════════════╝
# Comma-separated emails granted /admin access (in addition to users
# with user_metadata.is_admin=true).
ADMIN_ALLOWLIST_EMAILS=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  Copilot alert emails (N8N-S03 anomaly routing)              ║
# ╚═══════════════════════════════════════════════════════════════╝
# Comma-separated. Falls back to ADMIN_ALLOWLIST_EMAILS when blank.
COPILOT_TECH_EMAIL=
COPILOT_MANAGEMENT_EMAIL=
COPILOT_PRODUCTION_EMAIL=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  App URL                                                     ║
# ╚═══════════════════════════════════════════════════════════════╝
# Used for OAuth callbacks, email links, sitemap absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Postiz (Instagram auto-publishing) ──────────────────────────────
# Public API key from https://platform.postiz.com → Settings → Public API
POSTIZ_API_KEY=
# Optional: HMAC secret for the Postiz webhook (/api/postiz/webhook)
POSTIZ_WEBHOOK_SECRET=
